# ==============================================================================
# Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file and rename it to `.env` in the project root:
#    cp .env.example .env
# 2. Replace the placeholder values below with your local file paths and settings.
# 3. Do NOT commit your actual `.env` file to version control (it is in .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# Master Input Excel Files
# Paths to your input Excel files containing store URLs and official catalogs.
# Paths can be relative to project root (e.g. data/inputs/...) or absolute paths.
# ------------------------------------------------------------------------------

# Path to the Rakuten master Excel file containing store search URLs
RAKUTEN_MASTER_EXCEL="data/inputs/your_rakuten_stores_file.xlsx"

# Sheet name inside the Rakuten Excel file containing the store rows
RAKUTEN_SHEET_NAME="YourRakutenSheetName"

# Path to the Yahoo Shopping master Excel file containing store search URLs
YAHOO_MASTER_EXCEL="data/inputs/your_yahoo_stores_file.xlsx"

# Sheet name inside the Yahoo Shopping Excel file containing the store rows
YAHOO_SHEET_NAME="YourYahooSheetName"

# Path to the official catalog list Excel file with product model codes and prices
CATALOG_LIST_EXCEL="data/inputs/your_catalog_products_file.xlsx"

# ------------------------------------------------------------------------------
# Generated Output Excel Files
# Destination paths where scraped results and price comparison reports are saved.
# ------------------------------------------------------------------------------

# Output file path for scraped Rakuten store product prices
OUTPUT_SCRAPED_EXCEL="data/outputs/rakuten_scraped_prices.xlsx"

# Output file path for color-highlighted Rakuten price comparison report
OUTPUT_COMPARISON_EXCEL="data/outputs/rakuten_price_comparison.xlsx"

# Output file path for scraped Yahoo Shopping store product prices
OUTPUT_YAHOO_SCRAPED_EXCEL="data/outputs/yahoo_scraped_prices.xlsx"

# Output file path for color-highlighted Yahoo Shopping price comparison report
OUTPUT_YAHOO_COMPARISON_EXCEL="data/outputs/yahoo_price_comparison.xlsx"

# ------------------------------------------------------------------------------
# Scraping & Filtering Parameters
# ------------------------------------------------------------------------------

# Target brand or product keyword to filter items (e.g., GLOBAL)
TARGET_KEYWORD="YOUR_TARGET_KEYWORD"

# Fallback store ID if no ID is parsed from store URLs
DEFAULT_STORE_ID="123456"

# Maximum pagination depth per store to avoid infinite scraping loops (default: 50)
MAX_PAGES_PER_STORE=50

# HTTP request timeout in seconds (default: 15)
HTTP_TIMEOUT=15

# Maximum retry attempts for failed HTTP requests (default: 3)
HTTP_RETRIES=3

# Polite pause interval in seconds between consecutive page requests (default: 1.5)
COURTESY_PAUSE_SECONDS=1.5
